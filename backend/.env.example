# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://expert:expert@localhost:5432/expertvisiteur
# Long random text, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Website address(es) allowed to call the API, comma separated. No trailing slash, no path.
CORS_ORIGIN=https://nourtliba.github.io,http://localhost:5173
PORT=3000
# Used only the first time, to create the first admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please
